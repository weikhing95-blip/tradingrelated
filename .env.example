# Mag 7 News Bot — environment configuration.
# Copy to `.env` (gitignored) and fill in. Live mode requires all of the first
# block; `--dry-run` needs none of them.

# --- Telegram (control plane + publish plane) ---
TELEGRAM_BOT_TOKEN=          # from @BotFather
OWNER_USER_ID=               # your numeric Telegram user id (the only controller)
CHANNEL_ID=                  # target channel, e.g. -1001234567890 or @yourchannel

# --- Sources ---
FINNHUB_API_KEY=             # free tier from finnhub.io (news + earnings calendar)
SEC_EDGAR_USER_AGENT=Your Name your-email@example.com   # SEC requires a contact UA
FRED_API_KEY=                # free from fredaccount.stlouisfed.org; enables macro releases (CPI/PCE/PPI/claims)

# --- Behaviour ---
DIGEST_TIME_SGT=0900         # daily digest time, 24h SGT (HHMM)
SUMMARY_MODE=llm             # 'verbatim' (free) or 'llm' (bite-size summaries via Haiku)
SUMMARY_MODEL=               # LLM model id for summaries; blank = cheap Haiku (recommended)
ANTHROPIC_API_KEY=           # needed for SUMMARY_MODE=llm and the research agent
FEED_VOLUME=firehose         # 'firehose' (push all on-watchlist), 'moderate', or 'low'
MAX_ITEM_AGE_HOURS=24        # news older than this (hours) is dropped; lower = fresher feed (SEC filings always allowed)
DEDUP_WINDOW_HOURS=6         # collapse the same story across sources/tickers within this many hours
QUIET_HOURS=                 # blank/false = 24/7 (default). 'true' = mute non-critical 00:00–07:00 SGT
ENABLE_GOOGLE_NEWS=true      # whitelist-filtered Google News aggregator; links decoded to the real publisher. 'false' to disable
ENABLE_YAHOO_NEWS=true       # Yahoo Finance per-ticker news (free wire, real URLs). 'false' to disable
ENABLE_INSIDER=true          # 'false' disables large insider-trade alerts (uses Finnhub key)
ENABLE_FED_RSS=true          # 'false' disables Fed speeches + FOMC press releases (free RSS)
ENABLE_TRADING_HALTS=true    # 'false' disables Nasdaq trading-halt alerts (free RSS; critical)
ENABLE_ANALYST_RATINGS=true  # 'false' disables structured analyst upgrade/downgrade feed (Finnhub key)
ENABLE_ARTICLE_FETCH=true    # 'false' disables fetching full article text for richer LLM summaries (llm mode only)
ENABLE_ALPACA=true           # Alpaca (Benzinga) real-time news with full article bodies — active only when the keys below are set
ALPACA_API_KEY=              # free Alpaca market-data key id (no funded account needed) — from alpaca.markets
ALPACA_SECRET_KEY=           # free Alpaca market-data secret key
ENABLE_PRICE_MOVE=true       # 'false' disables unusual intraday-move alerts (Yahoo chart API; free, no key)
ENABLE_FEEDBACK_LEARNING=true # 👎 buttons on alerts + auto-learned suppression rules (non-blocking). 'false' to disable
ENABLE_SEMANTIC_DEDUP=true    # LLM check that catches paraphrased same-story dupes the lexical dedup misses. Runs whenever ANTHROPIC_API_KEY is set (independent of SUMMARY_MODE); cheap Haiku, only fires when there's a same-ticker candidate. Daily call count shown in /metrics. 'false' to opt out
PUBLIC_CHANNEL=false          # 'true' for a public channel: keeps curation buttons OFF public posts and mirrors each alert (with buttons) to the owner DM. Run /post_disclaimer once after enabling
PUBLIC_MODE=false             # 'true' = commercial/public product: HARD-disables in code every source not licensed for redistribution (Finnhub/Google/Yahoo/Alpaca/relay/econ-calendar). Only EDGAR, FRED, Fed RSS, Nasdaq halts, computed price-moves publish. See docs/SOURCE_LICENSES.md
PUBLIC_CHANNEL_HANDLE=        # e.g. @marketbrief — shown in the forward-friendly footer on public alerts (so a forwarded post still points home)
ENABLE_WEEKLY_ROUNDUP=true    # weekly "what you missed" post (top events by tier). 'false' to disable
WEEKLY_ROUNDUP_TIME_SGT=1800  # when to post the weekly roundup (HHMM, SGT); fires on Sunday
ENABLE_ECON_CALENDAR=true     # daily forward preview of high-impact macro releases (free ForexFactory feed). 'false' to disable
ECON_CALENDAR_TIME_SGT=0700   # when to post the daily macro preview (HHMM, SGT)
ECON_CALENDAR_CURRENCIES=USD,EUR,GBP,JPY,CNY  # which currencies' events to include
ECON_CALENDAR_IMPACT=High     # impact levels to include (e.g. High or High,Medium)
PRICE_MOVE_MULTIPLIER=2.0    # flag when |move on the day| ≥ this × the 2-week average daily move
PRICE_MOVE_MIN_PCT=3.0       # …and ≥ this % floor (so a flat name isn't flagged on a tiny wobble)
ENABLE_RESEARCH_AGENT=false  # weekly autonomous source-discovery agent (runs on Opus — costly). 'true' to enable

# --- Reliability (Phase 3) ---
ENABLE_BACKUP=true           # nightly SQLite backup DM'd to the owner (off-volume safety net). 'false' to disable
BACKUP_TIME_SGT=0330         # when to run the nightly backup (HHMM, SGT)
HEALTHCHECK_PING_URL=        # optional: URL pinged after each successful poll cycle so an external monitor (e.g. healthchecks.io) alerts if the worker dies. Blank = off

# --- Telegram user client (channel monitor, optional) ---
# Get TELEGRAM_API_ID + TELEGRAM_API_HASH from https://my.telegram.org → API Development Tools.
# Run `python -m mag7bot.telegram_setup` once to authenticate and save the session file.
TELEGRAM_API_ID=             # numeric, from my.telegram.org
TELEGRAM_API_HASH=           # hex string, from my.telegram.org
TELEGRAM_SESSION_PATH=       # path to .session file (auto-derived from DB_PATH if left empty)
TELEGRAM_SESSION_B64=        # optional: gzip+base64 of the .session file. On hosts with no file
                             # upload (e.g. Railway), the bot writes the session from this on first
                             # boot. Generate: gzip -c telegram_user.session | base64 -w0

# --- Storage ---
DB_PATH=mag7bot.db           # SQLite file path
